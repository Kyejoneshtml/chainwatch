RPC_HOST=127.0.0.1
RPC_PORT=8332
RPC_USER=chainwatch
RPC_PASSWORD=CHANGEME

ZMQ_HOST=127.0.0.1
ZMQ_RAWTX_PORT=28332
ZMQ_SEQUENCE_PORT=28335

# The 'default' ClickHouse user is restricted to true localhost and cannot
# be used through the published port (see ingestor/README.md). 'ingestor'
# is a dedicated user, SELECT+INSERT on chainwatch only -- see
# schema/ingestor-user.sql.example to (re)create it.
CH_HOST=127.0.0.1
CH_PORT=8123
CH_USER=ingestor
CH_PASSWORD=CHANGEME
CH_DATABASE=chainwatch
