# Local development only. Copy to docker-compose.override.yml.
#
# Compose merges this automatically. It publishes bitcoind's RPC and ZeroMQ
# ports so an ingestor running directly on the host can reach them, which is
# otherwise impossible on macOS because containers sit inside a VM.
#
# Every binding is 127.0.0.1, never 0.0.0.0. docs/16-security-posture.md
# requires that the RPC interface is never reachable beyond localhost: it is
# the administrative interface, and an attacker who reaches and authenticates
# to it can inspect wallet data and issue wallet commands.
#
# The same applies to ClickHouse's HTTP interface: the committed
# docker-compose.yml publishes nothing for it, so it is unreachable from the
# host by design. 8123 is opened here, localhost only, so the ingestor can
# write to it directly while running outside the container.
#
# The committed docker-compose.yml publishes only 8333. That remains the
# deployment configuration; this file is a local convenience.
services:
  bitcoind:
    ports:
      - "127.0.0.1:8332:8332"
      - "127.0.0.1:28332:28332"
      - "127.0.0.1:28333:28333"
      - "127.0.0.1:28334:28334"
      - "127.0.0.1:28335:28335"
  clickhouse:
    ports:
      - "127.0.0.1:8123:8123"
