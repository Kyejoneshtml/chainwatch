# Same ClickHouse credentials as ingestor/.env -- detection reuses the
# 'ingestor' CH user rather than a dedicated one. It already has SELECT and
# INSERT on chainwatch.* (schema/ingestor-user.sql.example), which is
# everything this component needs; no new grant required.
CH_HOST=127.0.0.1
CH_PORT=8123
CH_USER=ingestor
CH_PASSWORD=CHANGEME
CH_DATABASE=chainwatch

# Optional. Default 15s if unset -- see config.py for why.
DETECTION_INTERVAL_SECONDS=15
